<Window x:Class="ShogoLauncher.Views.RezViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive Contents" Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#FF1B1D24">
    <DockPanel Margin="14">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Foreground="#FF9A9891"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="#FF9A9891"/>
            <Button Content="Close" Width="80" DockPanel.Dock="Right" Click="Close_Click"/>
            <Button Content="Copy list" Width="80" Margin="8,0,8,0" DockPanel.Dock="Right"
                    Click="Copy_Click"
                    ToolTip="Copy the visible rows to the clipboard, tab-separated."/>
            <Button x:Name="ExtractAllButton" Content="Extract all" Width="90" DockPanel.Dock="Right"
                    Click="ExtractAll_Click"
                    ToolTip="Write every file in the archive to a folder you choose, keeping its folder structure. The archive is not modified."/>
            <Button x:Name="ExtractSelButton" Content="Extract selected" Width="110" Margin="8,0,8,0"
                    DockPanel.Dock="Right" Click="ExtractSelected_Click"
                    ToolTip="Write the highlighted rows to a folder you choose. Ctrl+A selects everything currently listed, so a filter plus Ctrl+A extracts just the matches."/>
            <Button x:Name="OpenButton" Content="Open…" Width="80" Margin="8,0,0,0"
                    DockPanel.Dock="Right" Click="Open_Click"
                    ToolTip="Open any .rez, including the game's own SHOGO.REZ and SOUND.REZ. Extracting from those is the first step of a texture or sound mod, and nothing here writes to the archive."/>
            <TextBox x:Name="FilterBox" TextChanged="Filter_TextChanged"
                     ToolTip="Matches anywhere in the path, name or type."/>
        </DockPanel>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Foreground="#FFE0532F"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="1.6*"/>
                <DataGridTextColumn Header="Type"   Binding="{Binding Type}"   Width="70"/>
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.4*"/>
                <DataGridTextColumn Header="Size"   Binding="{Binding SizeText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
