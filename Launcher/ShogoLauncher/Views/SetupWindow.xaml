<Window x:Class="ShogoLauncher.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Setup" Height="560" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <!-- Declared here rather than in App.xaml because MainWindow already
             declares its own under the same key; a second global one would
             shadow nothing and confuse the next reader. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- ===== Shogo not detected =====
                 Everything below this panel installs INTO the game folder, so
                 with no game there is nothing any of it can do. Before this
                 existed the window opened on a machine without Shogo showing
                 one DirectPlay card and no explanation - which reads as a
                 broken launcher rather than a missing game. -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding GameMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Shogo not detected" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource DimTextBrush}"
                               Text="ShogoFRESH needs an existing installation of Shogo: Mobile Armor Division - it is a modification of the 1998 game, not a copy of it. The Steam libraries, GOG's registry and the usual install paths were all checked and nothing turned up."/>
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource DimTextBrush}"
                               Text="If it is installed somewhere else, point at the folder holding Client.exe and SHOGO.REZ. Picking the folder above or below it is fine - that gets sorted out."/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Locate Shogo folder…" Width="170" Margin="0,0,8,0"
                                Click="LocateGame_Click" Style="{StaticResource AccentButton}"/>
                        <Button Content="Search again" Width="110" Margin="0,0,8,0" Click="RetryDetect_Click"
                                ToolTip="Re-run automatic detection. Use this if you have just installed the game."/>
                        <Button Content="Close launcher" Width="120" Click="QuitLauncher_Click"
                                ToolTip="Nothing here can do anything without the game. Closing loses nothing - the launcher keeps no state of its own until a folder is chosen."/>
                    </StackPanel>

                    <TextBlock Text="{Binding LocateMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               Visibility="{Binding HasLocateMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Everything from here needs a game folder. -->
            <StackPanel Visibility="{Binding GameFound, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,10"
                       Text="One-time fixes that make Shogo run well on modern Windows, applied into the game directory with automatic backups. Undo restores the exact prior state."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Enable All" Width="110" Margin="0,0,8,0" Click="EnableAll_Click"
                        Style="{StaticResource AccentButton}"
                        ToolTip="Apply every missing fix (and enable DirectPlay if needed - UAC prompt)."/>
                <Button Content="Re-check" Width="90" Margin="0,0,8,0" Click="RefreshSetup_Click"/>
                <Button Content="Close" Width="90" Click="Close_Click"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Fixes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                        <!-- Version beside the name: "v0.8.60" when current,
                                             "v0.8.59 -> v0.8.60" when an update is waiting, and
                                             nothing at all for the third-party fixes. -->
                                        <TextBlock Text="{Binding VersionText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource DimTextBrush}"/>
                                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource DimTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource DimTextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Accent outline while there is something to apply.
                                         The two ShogoFRESH-maintained cards go a step
                                         further with a filled accent - they are the ones
                                         that update over time - while Enable All keeps
                                         the only always-filled button in the window. -->
                                    <Button Content="Apply" Width="70" Margin="8,0,0,0" Click="ApplyFix_Click"
                                            IsEnabled="{Binding CanApply}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanApply}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanApply}" Value="True"/>
                                                            <Condition Binding="{Binding IsUpdateProne}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Undo" Width="70" Margin="8,0,0,0" Click="UndoFix_Click"
                                            IsEnabled="{Binding CanUndo}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- DirectPlay: Windows feature, not a file copy -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DirectPlay (Windows feature)" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="DirectPlayStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource DimTextBrush}"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource DimTextBrush}"
                                   Text="The engine's multiplayer transport rides DirectPlay service providers, a legacy Windows optional feature. Enabling runs DISM and shows a UAC prompt."/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="EnableDirectPlayButton" Content="Enable" Width="70"
                            VerticalAlignment="Center" Margin="8,0,0,0" Click="EnableDirectPlay_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="Fix payloads are read from the launcher's Redist folder." Margin="0,6,0,0"
                       Foreground="{StaticResource DimTextBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
