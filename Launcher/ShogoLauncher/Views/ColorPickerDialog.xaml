<Window x:Class="ShogoLauncher.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Night Color" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="16">

        <!-- Docked first so the buttons are always visible regardless of
             how the content above sizes. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click"
                    IsDefault="True" Style="{StaticResource AccentButton}"/>
            <Button Content="Cancel" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" Margin="0,0,0,12"
                       Text="World tint during the night phase of the day/night cycle. Only visible when the cycle is enabled (day/night seconds above 0)."/>

            <Border x:Name="Preview" Height="56" CornerRadius="4" Margin="0,0,0,12"
                    BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <TextBlock Text="R" VerticalAlignment="Center"/>
                <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedSlider, StringFormat={}{0:0.00}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center"/>
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider, StringFormat={}{0:0.00}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center"/>
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider, StringFormat={}{0:0.00}}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="Presets" Foreground="{StaticResource DimTextBrush}" Margin="0,10,0,4"/>
            <UniformGrid Columns="4">
                <Button Content="Neutral" Margin="0,0,6,0" Tag="0.5 0.5 0.5" Click="Preset_Click"/>
                <Button Content="Moonlit" Margin="0,0,6,0" Tag="0.35 0.4 0.6" Click="Preset_Click"/>
                <Button Content="Deep Blue" Margin="0,0,6,0" Tag="0.2 0.2 0.9" Click="Preset_Click"/>
                <Button Content="Pitch" Tag="0.1 0.1 0.15" Click="Preset_Click"/>
            </UniformGrid>
        </StackPanel>
    </DockPanel>
</Window>
