<Window x:Class="ShogoLauncher.Views.RebindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rebind" Height="215" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FF1B1D24">
    <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="PromptText" Foreground="#FFE8E6E3" FontSize="15" TextAlignment="Center"
                   Text="Press a key, mouse button, or scroll the wheel..."/>
        <TextBlock Foreground="#FF9A9891" FontSize="11" TextAlignment="Center" Margin="0,10,0,0"
                   Text="Keys, mouse buttons (incl. side buttons), and wheel up/down are supported.&#x0a;Modifier combos (Shift+X) aren't supported by the game engine."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="ClearButton" Content="Clear Binding" Width="100" Margin="0,0,10,0" Click="Clear_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
